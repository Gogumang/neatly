# 복사해서 .env.local 로 쓴다 (값은 절대 커밋하지 않는다)

# OpenAI: 대본(LLM)·목소리(TTS)·받아쓰기(whisper)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
TTS_MODEL=gpt-4o-mini-tts
# 표지 그림(이미지 생성). COVER_IMAGE=off 로 끌 수 있다
IMAGE_MODEL=gpt-image-2

# Supabase: 없으면 .data/ 로컬 파일에 저장 (개발용). 배포에는 필수
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# 공유 미리보기(OG) 이미지의 절대 주소. 배포 주소로 설정 (예: https://stage.vercel.app)
NEXT_PUBLIC_SITE_URL=
